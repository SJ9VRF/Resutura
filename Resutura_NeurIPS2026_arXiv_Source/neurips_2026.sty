\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}{1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}{\normalsize\bf}}
\newcommand{\@neuripsnotice}{\if@final 40th Conference on Neural Information Processing Systems (NeurIPS 2026).\else\if@preprint Preprint. Work in progress.\else Submitted to the 40th Conference on Neural Information Processing Systems (NeurIPS 2026). Do not distribute.\fi\fi}
\usepackage{fancyhdr}
