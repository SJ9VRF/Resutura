\def\@maketitle{\newpage\null\vskip -0.4in\begin{center}{\LARGE\bf \@title\par}\vskip 0.3in\if@anonymous {\large Anonymous Author(s)}\else {\large\lineskip .5em\begin{tabular}[t]{c}\@author\end{tabular}\par}\fi\end{center}\vskip 0.3in}
