\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{neuripsfirst}{\fancyhf{}\fancyfoot[L]{\footnotesize\@neuripsnotice}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
