% NeurIPS 2026 preprint-compatible style for Resutura arXiv bundle.
% Layout follows the 2026 NeurIPS public formatting parameters.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026-01-29 NeurIPS 2026 preprint-compatible style]
\newif\if@preprint\@preprintfalse
\newif\if@final\@finalfalse
\newif\if@anonymous\@anonymoustrue
\DeclareOption{preprint}{\@preprinttrue\@anonymousfalse}
\DeclareOption{final}{\@finaltrue\@anonymousfalse}
